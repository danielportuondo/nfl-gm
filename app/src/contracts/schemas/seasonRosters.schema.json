{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridiron-gm.dev/schemas/seasonRosters.schema.json",
  "title": "seasonRosters",
  "description": "Gridiron GM data contract for season/{yyyy}/rosters.json. Generated from app/src/contracts/schemas.ts — do not edit by hand. Data courtesy of nflverse (CC BY 4.0).",
  "type": "object",
  "properties": {
    "attribution": {
      "type": "string",
      "minLength": 10,
      "description": "Must mention nflverse and CC BY 4.0."
    },
    "season": {
      "type": "integer",
      "minimum": 1920,
      "maximum": 2200,
      "description": "NFL season year, e.g. 2015."
    },
    "rosters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 2,
        "maxLength": 3,
        "description": "Canonical franchise id (current abbreviation, e.g. LAR for STL/LA). See teams.ts."
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string",
              "minLength": 1,
              "description": "gsis_id for real players; \"gen-<seed>-<n>\" for procedural players."
            },
            "apy": {
              "description": "Real APY hint in $M when known (contracts data ~2011+).",
              "type": "number",
              "minimum": 0
            },
            "years": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "depth": {
              "description": "Depth-chart order at position, 1 = starter.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "playerId"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "attribution",
    "season",
    "rosters"
  ],
  "additionalProperties": false
}
