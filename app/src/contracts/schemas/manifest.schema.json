{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridiron-gm.dev/schemas/manifest.schema.json",
  "title": "manifest",
  "description": "Gridiron GM data contract for manifest.json. Generated from app/src/contracts/schemas.ts — do not edit by hand. Data courtesy of nflverse (CC BY 4.0).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string"
    },
    "attribution": {
      "type": "string",
      "minLength": 10,
      "description": "Must mention nflverse and CC BY 4.0."
    },
    "seasons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1920,
        "maximum": 2200,
        "description": "NFL season year, e.g. 2015."
      },
      "description": "Seasons with a season/{yyyy}/ chunk."
    },
    "latestRealSeason": {
      "type": "integer",
      "minimum": 1920,
      "maximum": 2200,
      "description": "Last season with complete real data; procedural generation begins after it."
    },
    "sizesBytes": {
      "description": "gzipped size per file, for the CI budget check.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "attribution",
    "seasons",
    "latestRealSeason"
  ],
  "additionalProperties": false
}
