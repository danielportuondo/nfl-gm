{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridiron-gm.dev/schemas/seasonSchedule.schema.json",
  "title": "seasonSchedule",
  "description": "Gridiron GM data contract for season/{yyyy}/schedule.json. Generated from app/src/contracts/schemas.ts — do not edit by hand. Data courtesy of nflverse (CC BY 4.0).",
  "type": "object",
  "properties": {
    "attribution": {
      "type": "string",
      "minLength": 10,
      "description": "Must mention nflverse and CC BY 4.0."
    },
    "season": {
      "type": "integer",
      "minimum": 1920,
      "maximum": 2200,
      "description": "NFL season year, e.g. 2015."
    },
    "weeks": {
      "type": "integer",
      "minimum": 17,
      "maximum": 19,
      "description": "Regular-season week count incl. byes."
    },
    "playoffFormat": {
      "type": "object",
      "properties": {
        "teams": {
          "anyOf": [
            {
              "type": "number",
              "const": 12
            },
            {
              "type": "number",
              "const": 14
            }
          ]
        },
        "byesPerConf": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "regularSeasonGames": {
          "anyOf": [
            {
              "type": "number",
              "const": 16
            },
            {
              "type": "number",
              "const": 17
            }
          ]
        }
      },
      "required": [
        "teams",
        "byesPerConf",
        "regularSeasonGames"
      ],
      "additionalProperties": false
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "\"<season>-<type>-<week>-<away>@<home>\""
          },
          "season": {
            "type": "integer",
            "minimum": 1920,
            "maximum": 2200,
            "description": "NFL season year, e.g. 2015."
          },
          "week": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "type": {
            "type": "string",
            "enum": [
              "REG",
              "WC",
              "DIV",
              "CONF",
              "SB"
            ]
          },
          "home": {
            "type": "string",
            "minLength": 2,
            "maxLength": 3,
            "description": "Canonical franchise id (current abbreviation, e.g. LAR for STL/LA). See teams.ts."
          },
          "away": {
            "type": "string",
            "minLength": 2,
            "maxLength": 3,
            "description": "Canonical franchise id (current abbreviation, e.g. LAR for STL/LA). See teams.ts."
          },
          "neutralSite": {
            "type": "boolean"
          },
          "homeScore": {
            "description": "Real result, for calibration only.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "awayScore": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "season",
          "week",
          "type",
          "home",
          "away"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "attribution",
    "season",
    "weeks",
    "playoffFormat",
    "games"
  ],
  "additionalProperties": false
}
